# ── Telegram ──────────────────────────────────────────────────
# Токен от @BotFather (обязателен)
TELEGRAM_TOKEN=123456789:AA...

# ── Хранилище и логи ──────────────────────────────────────────
DATABASE_PATH=data/passrw.db
LOG_DIR=logs
LOG_LEVEL=INFO

# ── Проверки расписания ───────────────────────────────────────
# Базовый интервал проверки трекинга, сек (ближе к дате — чаще)
CHECK_INTERVAL=60
MIN_CHECK_INTERVAL=30
# Кэш ответов pass.rw.by, сек
HTTP_CACHE_TTL=30
REQUEST_TIMEOUT=15
HTTP_CONCURRENCY=4
# Лимиты на пользователя
MAX_PASSENGERS=9
MAX_TRACKINGS_PER_USER=5
# Не чаще одного уведомления по трекингу за N секунд
NOTIFY_COOLDOWN=300
STOP_ON_SUCCESS=true
# Обслуживание БД и срок хранения логов/истории, сек / дни
MAINTENANCE_INTERVAL=21600
RETENTION_DAYS=30
# Сколько подряд неудачных проверок до алерта админу
PARSE_FAILURE_ALERT_THRESHOLD=5
# Горизонт продажи билетов на pass.rw.by, суток вперёд
SALE_WINDOW_DAYS=60

# ── Веб-админка ───────────────────────────────────────────────
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=5000
# Публичный адрес для команды /admin (если есть домен)
PUBLIC_URL=
# Доверенные reverse proxy через запятую для X-Forwarded-For.
# Пусто — заголовок игнорируется, клиентский IP берётся из подключения.
TRUSTED_PROXIES=

ADMIN_USERNAME=admin
# Задайте либо пароль, либо argon2-хеш (предпочтительно):
#   python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('ваш-пароль'))"
ADMIN_PASSWORD=change-me
ADMIN_PASSWORD_HASH=
SECRET_KEY=
# Выход из админки и смена пароля/хеша отзывают все активные сессии
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
# Разрешённые IP через запятую (пусто — без ограничения)
IP_WHITELIST=
# Bearer-токен для /metrics (пусто — эндпоинт без токена)
METRICS_TOKEN=

# ── Уведомления администратору ────────────────────────────────
ALERT_CHAT_ID=

# ── Локальное время ───────────────────────────────────────────
LOCAL_TIMEZONE=Europe/Minsk

# ─── Telegram ───────────────────────────────────────────────
# Токен бота от @BotFather
TELEGRAM_TOKEN=your_bot_token_here

# ─── Бот ────────────────────────────────────────────────────
# Интервал проверки билетов (секунды, минимум 10)
CHECK_INTERVAL=60
# Кеш HTTP-запросов к pass.rw.by (секунды; 0 — отключить)
HTTP_CACHE_TTL=30
# Таймаут запроса к сайту (секунды)
REQUEST_TIMEOUT=15
# Максимум пассажиров в одном поиске
MAX_PASSENGERS=9
# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
ERROR_LOG_FILE=logs/error.log
# Останавливать трекинг после первого успешного уведомления
STOP_ON_SUCCESS=true
# Максимум трекингов на пользователя
MAX_TRACKINGS_PER_USER=5
# Задержка между повторными уведомлениями (секунды)
NOTIFY_COOLDOWN=300
# Период обслуживания БД и срок хранения логов (секунды / дни)
MAINTENANCE_INTERVAL=21600
RETENTION_DAYS=30
# Часовой пояс для отображения времени
LOCAL_TIMEZONE=Europe/Minsk
# Путь к БД (по умолчанию data/ticket_bot.db)
DATABASE_PATH=data/ticket_bot.db
# Каталог флагов мягкой остановки (по умолчанию data/sync)
SYNC_DIR=data/sync

# ─── Админ-панель ───────────────────────────────────────────
ADMIN_USERNAME=admin
# Задайте ЛИБО пароль, ЛИБО хеш (рекомендуется хеш). Без пароля вход запрещён.
ADMIN_PASSWORD=
# Сгенерировать: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('пароль'))"
ADMIN_PASSWORD_HASH=
# Обязательно задайте случайный SECRET_KEY (например: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Включайте true только если админка доступна по HTTPS
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Общий rate limit админки: запросов за окно (секунды)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
# Список IP через запятую; пусто — без ограничения
IP_WHITELIST=
# Токен для /metrics; пусто — метрики публичны
METRICS_TOKEN=

# ─── Алерты ─────────────────────────────────────────────────
ALERT_CHAT_ID=
ENABLE_EMAIL_ALERTS=false
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
